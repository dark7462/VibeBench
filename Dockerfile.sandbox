FROM ubuntu:22.04

# Prevent interactive prompts during installation
ENV DEBIAN_FRONTEND=noninteractive

# Install fundamental tools, Python, Node/NPM, Java (Maven)
RUN apt-get update -qq && apt-get install -y -qq \
    curl \
    git \
    python3 \
    python3-pip \
    nodejs \
    npm \
    maven \
    openjdk-21-jdk \
    && rm -rf /var/lib/apt/lists/*

# Install OpenCode CLI
RUN curl -fsSL https://opencode.ai/install | OPENCODE_INSTALL_DIR=/usr/local/bin bash || npm install -g opencode-ai@latest

# Configure global executable paths
ENV PATH="/root/.opencode/bin:/root/.local/bin:/usr/local/bin:${PATH}"

WORKDIR /workspace
